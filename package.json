{
  "name": "budget-lab-charts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Budget Lab chart archive — versioned chart specs + data, built and published by budget-lab-chart-engine.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "validate": "node scripts/validate-all.mjs",
    "build": "node scripts/build-all.mjs",
    "catalog": "node scripts/build-catalog.mjs",
    "vendor-spec": "node scripts/vendor-spec.mjs",
    "site": "node scripts/assemble-site.mjs",
    "assets": "node scripts/build-assets.mjs",
    "thumbs": "node scripts/thumbs.mjs",
    "all": "npm run catalog && npm run vendor-spec && npm run validate && npm run build && npm run site && npm run assets && npm run thumbs",
    "dev": "node scripts/dev-server.mjs",
    "test": "node --test --test-concurrency=1"
  },
  "dependencies": {
    "budget-lab-chart-engine": "github:Budget-Lab-Yale/budget-lab-chart-engine#v1.10.0"
  },
  "devDependencies": {
    "playwright": "^1.61.0"
  }
}
